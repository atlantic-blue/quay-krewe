{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atlantic-blue/quay-krewe/skills/flow-map/schema.json",
  "title": "flows.json",
  "description": "What the flow map reads: the screens of a project, the stories that walk them, the tokens every screen is drawn in, and where the data lives.",
  "type": "object",
  "required": ["readAt", "tokens", "screens", "stories"],
  "properties": {
    "project": {
      "type": "string",
      "description": "The name of the project, put in the page title."
    },
    "readAt": {
      "type": "object",
      "description": "Where the screens were read from, so a reader can tell how old the map is.",
      "required": ["commit", "date"],
      "properties": {
        "commit": { "type": "string" },
        "date": { "type": "string" },
        "repository": { "type": "string", "description": "The address a source path links into." }
      }
    },
    "tokens": {
      "type": "object",
      "description": "Every colour, font, radius and space the page draws a screen with. The page writes each one as a custom property and holds no value of its own.",
      "required": ["colour", "font", "radius", "space"],
      "properties": {
        "colour": {
          "type": "object",
          "required": ["surface", "surface-low", "ink", "muted", "line", "primary", "on-primary", "frame"],
          "additionalProperties": { "type": "string" }
        },
        "font": {
          "type": "object",
          "required": ["sans", "mono"],
          "additionalProperties": { "type": "string" }
        },
        "radius": {
          "type": "object",
          "required": ["screen", "control", "card"],
          "additionalProperties": { "type": "string" }
        },
        "space": {
          "type": "object",
          "required": ["gap", "pad"],
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    },
    "screens": {
      "type": "object",
      "description": "Every screen, by the name a story refers to it with.",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/screen" }
    },
    "stories": {
      "type": "array",
      "description": "What a person does, as a walk over the screens.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/story" }
    },
    "dataModel": { "$ref": "#/$defs/dataModel" }
  },
  "$defs": {
    "screen": {
      "type": "object",
      "required": ["name", "surface", "status", "el"],
      "properties": {
        "name": { "type": "string", "description": "What a person calls this screen." },
        "surface": {
          "enum": ["mobile", "web"],
          "description": "Which frame it is drawn in: a phone for mobile, a browser for web."
        },
        "status": {
          "enum": ["built", "unwired", "designed", "named", "gap", "later", "proposed"],
          "description": "How far this screen has got."
        },
        "route": { "type": "string", "description": "The path that opens it. A web frame reads it in the address bar." },
        "source": { "type": "string", "description": "The files it was read from, separated by a comma and a space." },
        "ref": { "type": "string", "description": "The step of the path that builds it." },
        "q": { "type": "string", "description": "The open question, on a screen whose status is gap." },
        "el": {
          "type": "array",
          "description": "The shapes on the screen, from the top down.",
          "items": { "$ref": "#/$defs/element" }
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "defects": { "type": "array", "items": { "type": "string" } }
      }
    },
    "element": {
      "type": "object",
      "description": "One shape on a screen. It names the kind of shape and the component it stands for, so a building session can read which component goes where.",
      "required": ["t", "component"],
      "properties": {
        "t": {
          "enum": ["h", "p", "eyebrow", "top", "card", "btn", "btn2", "link", "links", "input", "fields",
            "list", "rows", "chips", "opts", "tiles", "stat", "quote", "code", "image", "table", "nav", "dock", "spacer"],
          "description": "The kind of shape."
        },
        "component": {
          "type": "string",
          "minLength": 1,
          "description": "The name of the library component this shape stands for, for example Button."
        },
        "to": { "type": "string", "description": "The screen this shape opens when a person presses it." },
        "active": { "type": "string", "description": "Which item of a nav or a dock is the one being read." },
        "on": { "type": "array", "items": { "type": "integer" }, "description": "Which options are chosen." },
        "multi": { "type": "boolean", "description": "More than one option may be chosen." },
        "sub": { "type": "string" },
        "right": { "type": "string" },
        "head": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
        "v": { "description": "What the shape says. A string, a list of strings, or a list of items with v and to." }
      }
    },
    "story": {
      "type": "object",
      "required": ["id", "title", "start", "nodes"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "description": "What the person is doing." },
        "story": { "type": "string", "description": "A paragraph under the title." },
        "steps": { "type": "string", "description": "How long the walk is, in the words a person would use." },
        "start": { "type": "string", "description": "The screen the prototype opens on." },
        "lanes": { "type": "array", "items": { "type": "string" }, "description": "A name for each row of the map." },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "description": "Each screen of the story, with the column and the row it sits at.",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [{ "type": "string" }, { "type": "integer" }, { "type": "integer" }]
          }
        },
        "edges": {
          "type": "array",
          "description": "A way from one screen to another: from, to, what it is called, and how far it has got.",
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              { "type": "string" },
              { "type": "string" },
              { "type": "string" },
              { "enum": ["built", "designed", "named", "missing", "later", "proposed"] }
            ]
          }
        }
      }
    },
    "dataModel": {
      "type": "object",
      "description": "Where the data lives. The Data view is hidden when this is absent.",
      "required": ["intro", "zones"],
      "properties": {
        "intro": { "type": "string" },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "tables"],
            "properties": {
              "title": { "type": "string" },
              "sub": { "type": "string" },
              "tables": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "status", "role", "fields"],
                  "properties": {
                    "name": { "type": "string" },
                    "status": { "enum": ["built", "designed", "proposed"] },
                    "role": { "type": "string" },
                    "fields": {
                      "type": "array",
                      "items": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            }
          }
        },
        "decisions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
